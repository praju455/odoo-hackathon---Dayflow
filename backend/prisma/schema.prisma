// ============================================================
// Dayflow HRMS — Prisma Schema
// Member 1 owns: Company, User (and their migrations)
// Member 2 owns: Attendance (extended), LeaveAllocation,
//                LeaveRequest, SalaryStructure, SalaryComponent
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────



// Member 2 extended: added LEAVE to track leave days in attendance


// Member 2 enum for leave request lifecycle




// Member 2 enum for wage period


// Member 2 enum for salary component calculation type


// ─────────────────────────────────────────
// Member 1 models (Company, User)
// ─────────────────────────────────────────

model Company {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  logoUrl   String?
  users     User[]
  projects  Project[]
  channelMessages ChannelMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                 String    @id @default(uuid())
  companyId          String
  loginId            String    @unique
  name               String
  email              String    @unique
  phone              String?
  dateOfBirth        DateTime?
  gender             String?
  maritalStatus      String?
  personalEmail      String?
  panCode            String?
  uanCode            String?
  accountNumber      String?
  homeAddress        String?
  passwordHash       String
  mustChangePassword Boolean   @default(false)
  role String @default("EMPLOYEE")
  department         String?
  jobTitle           String?
  managerId          String?
  profilePictureUrl  String?
  joiningDate        DateTime
  about              String?
  skills String @default("")
  certifications String @default("")
  interests String @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager User?   @relation("UserManager", fields: [managerId], references: [id])
  reports User[]  @relation("UserManager")

  // Member 2 relations
  attendance       Attendance[]
  leaveAllocations LeaveAllocation[]
  leaveRequests    LeaveRequest[]
  salaryStructure  SalaryStructure?
  notifications    Notification[]

  // Member 3 relations
  projectAssignments ProjectAssignment[]
  sentMessages       Message[]         @relation("MessageSender")
  receivedMessages   Message[]         @relation("MessageReceiver")
  channelMessages    ChannelMessage[]

  @@index([companyId])
  @@index([managerId])
}

// ─────────────────────────────────────────
// Member 2 — Attendance
// Extended from Member 1's base model:
//   + checkIn / checkOut timestamps
//   + workHours / extraHours computation fields
//   + LEAVE status added to AttendanceStatus enum
// These fields are the source of truth for payable days.
// ─────────────────────────────────────────

model Attendance {
  id         String           @id @default(uuid())
  userId     String
  date       DateTime         // store only the calendar date
  checkIn    DateTime? // full timestamp set on check-in
  checkOut   DateTime? // full timestamp set on check-out
  workHours  Float? // decimal hours: (checkOut - checkIn)
  extraHours Float? // hours beyond standard 8-hour day
  status String @default("ABSENT")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) // one record per employee per calendar day
  @@index([userId])
}

// ─────────────────────────────────────────
// Member 2 — Leave Allocation
// Tracks how many days of each leave type an employee has.
// Extended from Member 1's base: leaveType kept as String for
// flexibility; year scopes allocations per calendar year.
// Default seeds: PAID=24, SICK=7, UNPAID=9999 (effectively unlimited)
// ─────────────────────────────────────────

model LeaveAllocation {
  id        String    @id @default(uuid())
  userId    String
  leaveType String
  totalDays Int // annual entitlement
  usedDays  Int       @default(0)
  year      Int // e.g. 2026
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, leaveType, year]) // one record per type per year
  @@index([userId])
}

// ─────────────────────────────────────────
// Member 2 — Leave Request
// Extended from Member 1's base:
//   + allocationDays (computed from date range on create)
//   + remarks / attachmentUrl (for sick-leave certificates)
//   + adminComment (set by admin on approve/reject)
// ─────────────────────────────────────────

model LeaveRequest {
  id             String             @id @default(uuid())
  userId         String
  leaveType String
  startDate      DateTime
  endDate        DateTime
  allocationDays Int // (endDate - startDate) + 1, computed on create
  reason         String? // optional employee remarks
  attachmentUrl  String? // filename/path only; soft-required for SICK leave
  status String @default("PENDING")
  adminComment   String? // set by admin on approve/reject
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────
// Member 2 — Salary Structure
// Replaces Member 1's simpler annualCtc model with a full
// calculation engine: wageType, fixedWage, PF %, professionalTax.
// All component amounts are recomputed on every PUT /api/salary/:userId
// ─────────────────────────────────────────

model SalaryStructure {
  id                String            @id @default(uuid())
  userId            String            @unique // one structure per employee
  wageType String @default("MONTHLY")
  fixedWage         Float // gross wage (monthly or yearly)
  pfEmployeePercent Float             @default(12) // % of Basic deducted from employee
  pfEmployerPercent Float             @default(12) // % of Basic contributed by employer
  professionalTax   Float             @default(200) // flat monthly deduction (₹)
  effectiveFrom     DateTime          @default(now())
  components        SalaryComponent[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// Member 2 — Salary Component
// Each row is one pay component (Basic, HRA, etc.).
// compType drives how calculatedAmount is computed:
//   FIXED           → calculatedAmount = value
//   PERCENT_OF_WAGE → calculatedAmount = (value / 100) * fixedWage
//   PERCENT_OF_BASIC→ calculatedAmount = (value / 100) * Basic.calculatedAmount
// ─────────────────────────────────────────

model SalaryComponent {
  id                String        @id @default(uuid())
  salaryStructureId String
  name              String // e.g. "Basic", "HRA", "Performance Bonus"
  compType String
  value             Float // raw amount (FIXED) or percentage number (PERCENT_*)
  calculatedAmount  Float         @default(0) // always recomputed on save; never set manually
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@index([salaryStructureId])
}

// ─────────────────────────────────────────
// In-App Notifications
// ─────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────
// Projects (Member 3 feature)
// Admin creates projects; employees are assigned.
// ─────────────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?
  department  String?
  status      String   @default("ACTIVE") // ACTIVE | COMPLETED | IN_REVIEW
  progress    Int      @default(0)        // 0-100
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments ProjectAssignment[]

  @@index([companyId])
}

model ProjectAssignment {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────
// Direct Messages between users
// ─────────────────────────────────────────

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())

  sender   User @relation("MessageSender",   fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
}

// ─────────────────────────────────────────
// Channel Messages (team channels per company)
// ─────────────────────────────────────────

model ChannelMessage {
  id        String   @id @default(uuid())
  companyId String
  channel   String   // e.g. "general", "engineering", "announcements"
  userId    String
  content   String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, channel])
  @@index([userId])
}

