generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Company {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  logoUrl   String?
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                 String   @id @default(uuid())
  companyId          String
  loginId            String   @unique
  name               String
  email              String   @unique
  phone              String?
  passwordHash       String
  mustChangePassword Boolean  @default(false)
  role               Role     @default(EMPLOYEE)
  department         String?
  jobTitle           String?
  managerId          String?
  profilePictureUrl  String?
  joiningDate        DateTime
  about              String?
  skills             String[] @default([])
  certifications     String[] @default([])
  interests          String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager          User?             @relation("UserManager", fields: [managerId], references: [id])
  reports          User[]            @relation("UserManager")
  attendance       Attendance[]
  leaveAllocations LeaveAllocation[]
  leaveRequests    LeaveRequest[]
  salaryStructure  SalaryStructure?

  @@index([companyId])
  @@index([managerId])
}

model Attendance {
  id        String           @id @default(uuid())
  userId    String
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model LeaveAllocation {
  id        String   @id @default(uuid())
  userId    String
  leaveType String
  totalDays Int
  usedDays  Int      @default(0)
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, leaveType, year])
  @@index([userId])
}

model LeaveRequest {
  id        String             @id @default(uuid())
  userId    String
  leaveType String
  startDate DateTime
  endDate   DateTime
  reason    String?
  status    LeaveRequestStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SalaryStructure {
  id            String            @id @default(uuid())
  userId        String            @unique
  annualCtc     Decimal           @db.Decimal(12, 2)
  effectiveFrom DateTime
  components    SalaryComponent[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SalaryComponent {
  id                String   @id @default(uuid())
  salaryStructureId String
  name              String
  amount            Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@index([salaryStructureId])
}
